# --- Application ---
APP_NAME=Media Processing Microservice
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=media-processing-bucket
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/